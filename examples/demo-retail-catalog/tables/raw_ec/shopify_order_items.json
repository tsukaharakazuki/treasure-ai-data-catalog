  "sample_queries": [
    {
      "title": "SKU別売上 TOP20（直近30日）",
      "engine": "trino",
      "sql": "SELECT i.sku, SUM(i.unit_price * i.quantity - i.discount_amount) AS sales\nFROM raw_ec.shopify_order_items i\nJOIN raw_ec.shopify_orders o ON o.order_id = i.order_id\nWHERE td_interval(i.time, '-30d', 'JST')\n  AND o.status NOT IN ('cancelled', 'refunded')\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 20"
    }
  ]
}
