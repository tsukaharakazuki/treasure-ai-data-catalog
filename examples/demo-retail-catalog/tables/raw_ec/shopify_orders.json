  "columns": [
    {
      "name": "order_id",
      "type": "varchar",
      "logical_name": "注文ID",
      "logical_name_status": "confirmed",
      "description": "Shopify の注文番号（#付きを除去済み）",
      "is_primary_key": true,
      "pii": "none"
    },
    {
      "name": "customer_id",
      "type": "varchar",
      "logical_name": "EC会員番号",
      "logical_name_status": "confirmed",
      "description": "Shopify 側の会員番号。統合会員IDとは別体系。",
      "id_system": "ec_customer_id",
      "pii": "identifier",
      "stats": {
        "null_ratio": 0.08,
        "min_length": 8,
        "max_length": 8,
        "pattern": "\"C\" + 7桁の数字"
      }
    },
    {
      "name": "order_total",
      "type": "double",
      "logical_name": "注文合計金額（税込）",
      "logical_name_status": "confirmed",
      "description": "送料・割引適用後の税込合計。明細の合計とは一致しないことがある。"
    },
    {
      "name": "status",
      "type": "varchar",
      "logical_name": "注文ステータス",
      "logical_name_status": "confirmed",
      "values": {
        "paid": "支払済",
        "fulfilled": "出荷済",
        "cancelled": "キャンセル",
        "refunded": "返金済"
      }
    },
    {
      "name": "ordered_at",
      "type": "varchar",
      "logical_name": "注文日時（JST文字列）",
      "logical_name_status": "confirmed",
      "description": "yyyy-MM-dd HH:mm:ss（JST）"
    },
    {
      "name": "coupon_code",
      "type": "varchar",
      "logical_name": "クーポンコード",
      "logical_name_status": "confirmed",
      "description": "注文に適用されたクーポン。未使用は NULL。"
    },
    {
      "name": "time",
      "type": "bigint",
      "logical_name": "データ取込時刻（UNIX秒）",
      "logical_name_status": "confirmed",
      "description": "TD のパーティションキー。期間指定は td_interval(time, ...) を使う。",
      "is_partition_key": true
    }
  ],
